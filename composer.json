{
    "name": "shakewellagency/passkit-laravel",
    "description": "Laravel package for PassKit API integration with comprehensive CRUD management",
    "keywords": ["laravel", "passkit", "wallet", "apple-wallet", "google-pay", "mobile-passes", "loyalty", "membership"],
    "type": "library",
    "license": "MIT",
    "version": "2.0.0",
    "authors": [
        {
            "name": "Shakewell Agency",
            "email": "hello@shakewell.agency",
            "homepage": "https://shakewell.agency"
        }
    ],
    "homepage": "https://github.com/shakewell-agency/passkit-laravel",
    "support": {
        "issues": "https://github.com/shakewell-agency/passkit-laravel/issues",
        "source": "https://github.com/shakewell-agency/passkit-laravel"
    },
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "google/protobuf": "^3.24|^4.0",
        "grpc/grpc": "^1.50",
        "spiral/roadrunner-grpc": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "ShakewellAgency\\PassKitLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ShakewellAgency\\PassKitLaravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ShakewellAgency\\PassKitLaravel\\PassKitServiceProvider"
            ],
            "aliases": {
                "PassKit": "ShakewellAgency\\PassKitLaravel\\Facades\\PassKit"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}